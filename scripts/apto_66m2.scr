; Apartamento 66m2 - Script CAD Lite
; 2 habitaciones, 2 baños, cocina, sal-comedor, terraza
; Escala: 1 unidad = 1 metro

; === CAPAS ===
LAYER NEW WALLS
LAYER COLOR WALLS #FFFFFF
LAYER NEW DOORS
LAYER COLOR DOORS #FFCC00
LAYER NEW WINDOWS
LAYER COLOR WINDOWS #44AAFF
LAYER NEW TEXT
LAYER COLOR TEXT #88FF88
LAYER NEW DIMS
LAYER COLOR DIMS #888888

; === MUROS PERIMETRALES (doble línea) ===
LAYER SET WALLS

; Muro inferior (doble)
LINE -0.15,-0.15 11.15,-0.15
LINE 0.15,0.15 10.85,0.15

; Muro superior (terraza)
LINE -0.15,6.15 11.15,6.15
LINE 0.15,5.85 10.85,5.85

; Muro izquierdo (doble)
LINE -0.15,-0.15 -0.15,6.15
LINE 0.15,0.15 0.15,5.85

; Muro derecho (doble)
LINE 11.15,-0.15 11.15,6.15
LINE 10.85,0.15 10.85,5.85

; === MUROS INTERIORES ===
; Vertical BEDRM1-BATH1 (x=3.5)
LINE 3.5,0 3.5,4.8

; Vertical BATH1-KITCHEN (x=5.5)
LINE 5.5,2.8 5.5,6.0

; Vertical KITCHEN-BEDRM2 (x=8.5)
LINE 8.5,0 8.5,4.8

; Horizontal living/bedrm split (y=2.8)
LINE 0,2.8 8.5,2.8

; Horizontal interior/terraza (y=4.8)
LINE 0,4.8 11,4.8

; BATH2 vertical (x=8.5, lower)
LINE 8.5,0 8.5,2.8

; === PUERTAS ===
LAYER SET DOORS
LINE 1.5,0 2.4,0
LINE 5.8,2.8 6.7,2.8
LINE 7.0,0 7.9,0
LINE 9.2,2.8 10.1,2.8
LINE 9.5,0 10.4,0
LINE 4.7,4.8 5.6,4.8

; === VENTANAS ===
LAYER SET WINDOWS
LINE 0,0.8 0,2.5
LINE 3.2,0 7.2,0
LINE 11,2.0 11,4.5
LINE 5.5,4.8 8.2,4.8

; Baranda terraza (líneas cortas)
LINE 0,4.8 0.3,4.8
LINE 0.6,4.8 0.9,4.8
LINE 1.2,4.8 1.5,4.8
LINE 1.8,4.8 2.1,4.8
LINE 2.4,4.8 2.7,4.8
LINE 3.0,4.8 3.3,4.8
LINE 3.6,4.8 3.9,4.8
LINE 4.2,4.8 4.5,4.8
LINE 9.0,4.8 9.3,4.8
LINE 9.6,4.8 9.9,4.8
LINE 10.2,4.8 10.5,4.8
LINE 10.8,4.8 11.0,4.8

; === TEXTOS ===
LAYER SET TEXT
TEXT 1.75,1.5 BEDROOM 1
TEXT 4.5,1.5 BATH 1
TEXT 7.0,3.8 KITCHEN
TEXT 9.75,1.5 BEDROOM 2
TEXT 9.75,3.8 BATH 2
TEXT 3.5,0.8 LIVING / DINING
TEXT 5.5,5.5 TERRACE

; === COTAS ===
LAYER SET DIMS
DIM 0,-0.8 11,-0.8 5.5,-1.3
DIM -0.8,0 -0.8,6 -1.3,3
DIM 0,5.2 3.5,5.2 1.75,5.6
DIM 3.5,5.2 5.5,5.2 4.5,5.6
DIM 5.5,3.3 8.5,3.3 7.0,3.7

; === ZOOM EXTENTS ===
ZOOM E
